# Supabase
# Get from Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...your-service-role-key

# Auth tokens. Generate with: openssl rand -hex 32
CLAUDE_TOKEN=replace-me-with-openssl-rand-hex-32
MANUS_TOKEN=replace-me-with-openssl-rand-hex-32

# Local dev only. Railway injects PORT automatically.
PORT=3000

# Test client only. Set after Railway deploy.
BROKER_URL=https://stragentic-broker-production.up.railway.app
